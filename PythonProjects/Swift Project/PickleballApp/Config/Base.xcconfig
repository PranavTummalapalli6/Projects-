// Shared build settings. Secrets live in Config/Secrets.xcconfig (git-ignored).
// Copy Secrets.example.xcconfig → Secrets.xcconfig and fill in your Supabase project values.
// With no values the app runs in clearly-labelled demo mode on bundled fictional data.

APP_BUNDLE_ID = dev.pickleballnow.app
SUPABASE_URL =
SUPABASE_ANON_KEY =
USE_WEATHERKIT = NO

#include? "Secrets.xcconfig"
