// Copy to Config/Secrets.xcconfig (git-ignored). Only the PUBLIC anon key belongs here —
// never the service-role key. Note the `/$()/` trick: `//` starts a comment in xcconfig files.

SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-public-anon-key

// Set to YES after enabling the WeatherKit capability (requires the paid Apple Developer Program).
USE_WEATHERKIT = NO

// Free provisioning needs a bundle id unique to you when running on a physical device.
// APP_BUNDLE_ID = com.yourname.pickleballnow
