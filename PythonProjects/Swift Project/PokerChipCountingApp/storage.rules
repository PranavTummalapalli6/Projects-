rules_version = '2';

// Chip photos are private. The app never reads or writes Storage directly:
// ChipVisionService stores photos with the Admin SDK (which bypasses these
// rules) and hands out short-lived signed URLs. Direct client access is denied
// for every path, so an unauthenticated request for a stored photo fails.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
